SPRING_PROFILES_ACTIVE=prod
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/it
SPRING_DATASOURCE_USERNAME=it
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Production OIDC resource-server configuration. Use the same issuer/audience as the SPA.
JWT_ISSUER=https://your-tenant.example.com/
JWT_AUDIENCE=clean-it-api
JWT_JWK_SET_URI=https://your-tenant.example.com/.well-known/jwks.json
# HMAC fallback for local/test tokens only; leave blank when using an OIDC JWK set.
JWT_SECRET=

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
ALLOW_BASIC_AUTH=false
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
