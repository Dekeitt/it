SPRING_PROFILES_ACTIVE=prod
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/it
SPRING_DATASOURCE_USERNAME=it
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Production OIDC resource-server configuration. The token must emit CLIENT/CLEANER/ADMIN roles as appropriate.
JWT_ISSUER=https://your-tenant.example.com/
JWT_AUDIENCE=clean-it-api
JWT_JWK_SET_URI=https://your-tenant.example.com/.well-known/jwks.json
JWT_SECRET=

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=

# Stripe Connect marketplace. Keep disabled until business policy and Stripe account are configured.
# Fee is basis points: 1500 = 15%. No production commission is assumed by the code (default is 0).
CONNECT_ENABLED=false
CONNECT_PLATFORM_FEE_BPS=0
# Comma-separated ISO alpha-2 countries, e.g. ES,PT. Required when CONNECT_ENABLED=true.
CONNECT_ALLOWED_COUNTRIES=
# Explicitly decide both before refunding any connected payment.
CONNECT_REFUND_REVERSE_TRANSFER=unset
CONNECT_REFUND_APPLICATION_FEE=unset
# false = destination charge without on_behalf_of; toggle only after confirming settlement/MoR responsibilities.
CONNECT_ON_BEHALF_OF=false
# Fixed trusted frontend URLs; never supplied by browser input.
CONNECT_REFRESH_URL=https://cleanit.es/account?connect=refresh
CONNECT_RETURN_URL=https://cleanit.es/account?connect=complete

# Transactional notification outbox worker and 24h reminders.
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_WORKER_DELAY_MS=5000
NOTIFICATIONS_REMINDERS_ENABLED=true
NOTIFICATIONS_REMINDERS_DELAY_MS=3600000

# SMTP email delivery. Keep disabled until a provider is configured.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_FROM=no-reply@cleanit.es
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# PWA Web Push. Generate a persistent VAPID P-256 keypair and store only in Railway variables.
NOTIFICATIONS_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cleanit.es

ALLOW_BASIC_AUTH=false
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
