# Empty uses same-origin /api (recommended behind the frontend reverse proxy)
VITE_API_BASE_URL=

# OIDC Authorization Code + PKCE. Leave authority/client ID empty for local manual-token development.
VITE_OIDC_AUTHORITY=https://your-tenant.example.com
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
# Optional API audience/resource identifier when required by the provider.
VITE_OIDC_AUDIENCE=clean-it-api
