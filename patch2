+    .error { color: #ffb5b5; }
+    .ok { color: #8ef0d2; }
+    :focus-visible { outline: 3px solid #ffda79; outline-offset: 3px; }
+  </style>
+</head>
+<body>
+<main>
+  <p aria-hidden="true">CLEAN IT · STRIPE</p>
+  <h1>Completa el pago</h1>
+  <p>Los datos de la tarjeta se envían directamente a Stripe. Clean IT no almacena la tarjeta.</p>
+  <div class="summary" aria-live="polite">
+    <span>Reserva <strong id="reservation-label">—</strong></span>
+    <strong id="amount-label">Cargando…</strong>
+  </div>
+  <form id="payment-form" hidden>
+    <div id="payment-element"></div>
+    <button id="submit-button" type="submit"><span id="button-text">Pagar ahora</span></button>
+  </form>
+  <div id="message" class="message" role="status" aria-live="polite"></div>
+  <a class="button" href="/">Volver al panel</a>
+</main>
+<script>
+  const params = new URLSearchParams(location.search);
+  const reservationId = Number(params.get('reservationId'));
+  const returnedClientSecret = params.get('payment_intent_client_secret');
+  const message = document.getElementById('message');
+  const form = document.getElementById('payment-form');
+  const submitButton = document.getElementById('submit-button');
+  let stripe;
+  let elements;
+
+  document.getElementById('reservation-label').textContent = Number.isInteger(reservationId) && reservationId > 0
+    ? `#${reservationId}` : 'no válida';
+
+  function authHeader() {
+    try {
+      const auth = JSON.parse(sessionStorage.getItem('it-auth') || '{}');
+      if (auth.mode === 'bearer' && auth.token) return { Authorization: `Bearer ${auth.token}` };
+      if (auth.mode === 'basic' && auth.basicUser && auth.basicPassword) {
+        return { Authorization: `Basic ${btoa(`${auth.basicUser}:${auth.basicPassword}`)}` };
+      }
+    } catch (_) { }
+    return {};
+  }
+
+  function show(text, type = '') {
+    message.textContent = text;
+    message.className = `message ${type}`;
+  }
+
+  function formatMoney(cents, currency) {
+    return new Intl.NumberFormat('es-ES', { style: 'currency', currency: currency.toUpperCase() })
+      .format(cents / 100);
+  }
+
+  async function initialize() {
+    if (!Number.isInteger(reservationId) || reservationId <= 0) {
+      show('La reserva indicada no es válida.', 'error');
+      return;
+    }
+    show('Preparando el pago…');
+    const response = await fetch('/api/payments/create-intent', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', ...authHeader() },
+      body: JSON.stringify({ reservationId })
+    });
+    if (response.status === 401) {
+      throw new Error('Tu sesión ha caducado. Vuelve al panel e inicia sesión de nuevo.');
+    }
+    if (!response.ok) {
+      const problem = await response.json().catch(() => ({}));
+      throw new Error(problem.detail || problem.error || 'No se pudo preparar el pago.');
+    }
+    const payment = await response.json();
+    if (!payment.publishableKey || !payment.clientSecret) {
+      throw new Error('Stripe no está configurado correctamente.');
+    }
+
+    document.getElementById('amount-label').textContent = formatMoney(payment.amountCents, payment.currency);
+    stripe = Stripe(payment.publishableKey);
+    if (returnedClientSecret) {
+      if (returnedClientSecret !== payment.clientSecret) {
+        throw new Error('El retorno de Stripe no corresponde a esta reserva.');
+      }
+      const { paymentIntent, error } = await stripe.retrievePaymentIntent(returnedClientSecret);
+      if (error) throw new Error(error.message || 'No se pudo consultar el estado del pago.');
+      if (paymentIntent.status === 'succeeded') {
+        show('Pago completado. La reserva se actualizará al recibir la confirmación segura de Stripe.', 'ok');
+        return;
+      }
+      if (paymentIntent.status === 'processing') {
+        show('El pago sigue procesándose. Puedes volver al panel; el estado se actualizará automáticamente.', 'ok');
+        return;
+      }
+      if (paymentIntent.status === 'requires_payment_method') {
+        show('El pago no se completó. Revisa el método de pago e inténtalo de nuevo.', 'error');
+      }
+    }
+
+    elements = stripe.elements({
+      clientSecret: payment.clientSecret,
+      appearance: { theme: 'night', variables: { colorPrimary: '#5fe1c1', borderRadius: '10px' } }
+    });
+    elements.create('payment').mount('#payment-element');
+    form.hidden = false;
+    show('');
+  }
+
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    submitButton.disabled = true;
+    document.getElementById('button-text').textContent = 'Procesando…';
+    show('Confirmando el pago…');
+    const { error } = await stripe.confirmPayment({
+      elements,
+      confirmParams: { return_url: `${location.origin}/checkout.html?reservationId=${encodeURIComponent(reservationId)}&complete=1` }
+    });
+    if (error) {
+      show(error.message || 'No se pudo confirmar el pago.', 'error');
+      submitButton.disabled = false;
+      document.getElementById('button-text').textContent = 'Pagar ahora';
+    }
+  });
+
+  initialize().catch(error => show(error.message, 'error'));
+</script>
+</body>
+</html>
